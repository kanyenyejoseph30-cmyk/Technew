rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read for shop visitors, write allowed for boutique manager
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: read and write for clients, drivers and admin
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection: eMoney, boutique rates and configurations
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
